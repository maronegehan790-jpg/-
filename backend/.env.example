# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Number of reverse-proxy hops to trust for the X-Forwarded-For header.
# 0 (the default) trusts nothing and reads the socket address, which is correct
# for local development. This is a security setting: with it enabled, req.ip
# comes from a client-supplied header, so too high a value lets a caller rotate
# the header and bypass the per-IP rate limits. Set it to the exact number of
# proxies in front of the API (1 behind a single load balancer) and no higher.
TRUST_PROXY_HOPS=0

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zizo_lms?schema=public

# Redis (sessions, rate-limit counters, caching)
REDIS_URL=redis://localhost:6379

# Integration test datastores. These MUST point somewhere other than
# DATABASE_URL and REDIS_URL: the harness truncates every table and flushes the
# Redis database before each test, and it refuses to run if either one matches
# its development counterpart.
#   - zizo_lms_test is a separate database on the same server; the test harness
#     creates it on first run (docker-compose only provisions zizo_lms).
#   - /1 selects Redis database 1, leaving development data on database 0 alone.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zizo_lms_test?schema=public
TEST_REDIS_URL=redis://localhost:6379/1

# JWT authentication (use long random strings, at least 32 characters)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3-compatible storage (AWS / MinIO / Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=zizo-lms-private
S3_ACCESS_KEY_ID=change_me
S3_SECRET_ACCESS_KEY=change_me
S3_FORCE_PATH_STYLE=true

# Transactional email (password reset delivery).
# The provider is not fixed by this version: the adapter posts JSON over HTTPS
# with a bearer key, so SES v2, Resend, Postmark and SendGrid all work by
# pointing EMAIL_API_URL at their send endpoint. Leave all three blank in
# development and reset links are printed to the server console instead; the
# app refuses to boot that way when NODE_ENV=production, because the token
# would then be logged in the clear rather than delivered.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@example.com

# Initial admin account created by the seed script
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change_me
